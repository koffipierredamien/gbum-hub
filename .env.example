# S2 (ADR-012) — l'adresse de la base est une ressource attachée.
# Ce fichier ne contient AUCUNE valeur réelle : il dit ce qui est attendu.
# Passer d'un PostgreSQL local à un PostgreSQL payé par le mouvement se fait
# en changeant cette seule ligne. Aucun code ne change.
DATABASE_URL=postgres://gbum:gbum@localhost:5433/gbum

# S5 / ADR-013 — les fichiers vivent hors de la base.
# "disque" aujourd'hui ; "s3" le jour où le mouvement paie. Rien d'autre à changer.
STOCKAGE_PILOTE=disque
STOCKAGE_DISQUE_RACINE=./.donnees/fichiers
STOCKAGE_URL_PUBLIQUE=http://localhost:3000/fichiers

# Renseignés uniquement quand STOCKAGE_PILOTE=s3
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCES_CLE=
# S3_ACCES_SECRET=
