# Le fichier d'environnement DU SERVEUR — à créer sur la machine, jamais versionné.
# Il se nomme « .env » à côté de docker-compose.production.yml.

# Le mot de passe de la base. Tirez-le au sort, ne le réutilisez nulle part.
POSTGRES_USER=gbum
POSTGRES_PASSWORD=un-mot-de-passe-tire-au-sort
POSTGRES_DB=gbum

# « base » est le nom du service dans le compose : à l'intérieur du réseau
# Docker, c'est ainsi que la machine s'appelle. Le port est 5432, celui de
# PostgreSQL — le 5433 du poste de travail n'existe que pour éviter un conflit
# local.
DATABASE_URL=postgres://gbum:un-mot-de-passe-tire-au-sort@base:5432/gbum

STOCKAGE_PILOTE=disque
STOCKAGE_URL_PUBLIQUE=https://VOTRE-DOMAINE/fichiers
