{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "creeLe": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "sujet": {
      "type": "string",
      "enum": ["rejoindre", "soutenir", "question", "autre", "souvenir"]
    },
    "nom": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "contact": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "ville": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        {
          "type": "null"
        }
      ]
    },
    "villeLibre": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 120
        },
        {
          "type": "null"
        }
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  },
  "required": [
    "version",
    "id",
    "creeLe",
    "sujet",
    "nom",
    "contact",
    "ville",
    "villeLibre",
    "message"
  ],
  "additionalProperties": false
}
