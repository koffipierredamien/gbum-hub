{
  "extends": "../../tsconfig.base.json",
  "include": ["src", "test"],
  "compilerOptions": {
    // Les types Node servent au SEUL test de dépendances, qui lit les
    // fichiers de src/ pour vérifier qu'ils n'importent rien de technique.
    // C'est ce test — pas la configuration — qui interdit à src/ d'y toucher :
    // un garde-fou vérifié vaut mieux qu'un garde-fou déclaré.
    "types": ["node"]
  }
}
